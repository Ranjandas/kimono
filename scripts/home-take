#!/usr/bin/env bash
# Makes Kimono the home screen on a Google TV Streamer by disabling the stock launcher and Google's setup
# helper (route A in docs/adr/0001-home-takeover.md). Undo with scripts/home-restore.
#
#   scripts/home-take [--dry-run] [--yes]
#
# Set ADB_SERIAL when more than one device is connected.
set -euo pipefail
# shellcheck source=scripts/lib-home.sh
. "$(dirname "$0")/lib-home.sh"

ASSUME_YES=0
for arg in "$@"; do
    case $arg in
        --dry-run) DRY_RUN=1 ;;
        --yes) ASSUME_YES=1 ;;
        -h | --help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown option $arg" ;;
    esac
done

require_device
adb_ shell pm path "$KIMONO" >/dev/null 2>&1 || die "Kimono isn't installed; install the debug APK first"

echo "Before:"
show_state

# adb over 'adb tcpip' is gone after a reboot, and wireless debugging's port changes, so a reboot can leave the
# stock launcher off with no adb to restore it. Say so before changing anything.
if [ -z "$(adb_ shell getprop persist.adb.tcp.port | tr -d '\r')" ]; then
    echo
    echo "warning: adb on this device won't come back by itself after a reboot. If the TV reboots before you"
    echo "run home-restore, reconnect with wireless debugging (Settings > System > Developer options), which"
    echo "Kimono's drawer can open. See 'Recovery' in docs/DEVELOPING.md."
fi

if [ "$DRY_RUN" -eq 0 ] && [ "$ASSUME_YES" -eq 0 ]; then
    echo
    read -r -p "Disable $STOCK_HOME and $SETUP_HELPER so Home opens Kimono? Type yes: " answer
    [ "$answer" = yes ] || die "nothing changed"
fi

echo
change shell pm disable-user --user 0 "$STOCK_HOME"
change shell pm disable-user --user 0 "$SETUP_HELPER"

if [ "$DRY_RUN" -eq 1 ]; then
    exit 0
fi

# The HOME role moves to Kimono on its own once both are off; give it a moment.
for _ in 1 2 3 4 5; do
    case $(current_home) in "$KIMONO"/*) break ;; esac
    sleep 1
done

echo
echo "After:"
show_state
case $(current_home) in
    "$KIMONO"/*) adb_ shell input keyevent KEYCODE_HOME; echo; echo "Done. Home opens Kimono. Undo with scripts/home-restore." ;;
    *) die "Home doesn't resolve to Kimono; run scripts/home-restore to undo" ;;
esac
