<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    Black behind the first frame and the splash screen, whatever the Kimono theme, rather than the platform's
    dark grey: a cold start can show it for several seconds, and on an OLED panel black pixels are off.
    -->
    <style name="Theme.Kimono" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
