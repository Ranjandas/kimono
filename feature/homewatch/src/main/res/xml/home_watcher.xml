<?xml version="1.0" encoding="utf-8"?>
<!--
    As little as the job needs: only window changes, only from Google TV's two home apps, and no window contents.
    Kimono never sees what's on screen in any other app.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/home_watcher_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher" />
