<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Brings Kimono back when Google TV's home comes to the front. The user switches it on in Settings >
            Accessibility, and off again there. Only the system can bind it.
        -->
        <service
            android:name=".HomeWatcherService"
            android:exported="true"
            android:label="@string/home_watcher_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_watcher" />
        </service>
    </application>
</manifest>
